{
  "name": "social",
  "version": "0.5.0",
  "apiVersion": 5,
  "permissions": [
    "db",
    "net"
  ],
  "depends": {
    "llm": "*",
    "agent": "optional"
  },
  "conflicts": [],
  "commands": [
    {
      "name": "social",
      "aliases": [
        "社交"
      ],
      "description": "拟人群聊帮助",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social status",
      "aliases": [
        "社交 状态"
      ],
      "description": "查看群状态与权限",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social persona",
      "aliases": [
        "社交 人格"
      ],
      "description": "查看或切换本群人格",
      "usage": "/social persona [ID|名称|off]",
      "permission": "group_admin",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social mode",
      "aliases": [
        "社交 模式"
      ],
      "description": "切换本群发言模式",
      "usage": "/social mode <auto|at|off>",
      "permission": "group_admin",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social memory",
      "aliases": [
        "社交 记忆"
      ],
      "description": "管理本群长期记忆",
      "usage": "/social memory [list|add <内容>|clear]",
      "permission": "group_admin",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social forgetme",
      "aliases": [
        "忘掉我"
      ],
      "description": "删除本人在本群记忆",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social privacy",
      "aliases": [
        "社交 隐私"
      ],
      "description": "开关个人记忆收集",
      "usage": "/social privacy <on|off>",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social collect",
      "aliases": [
        "收藏表情"
      ],
      "description": "收藏当前或引用表情包",
      "usage": "/social collect [标签] [分类:xxx]",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social memes",
      "aliases": [
        "表情库"
      ],
      "description": "查看管理表情包库",
      "usage": "/social memes [关键词|disable <id>|enable <id>|del <id>]",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social voicetest",
      "aliases": [
        "语音测试"
      ],
      "description": "测试QQ原生语音发送",
      "usage": "/social voicetest <wav-b64|wav-url|url <音频URL>>",
      "permission": "group_admin",
      "scenes": [
        "group"
      ]
    },
    {
      "name": "social sync",
      "aliases": [
        "同步人格"
      ],
      "description": "同步人格到Agent",
      "permission": "group_admin",
      "scenes": [
        "group"
      ]
    }
  ],
  "regex": [],
  "events": [
    {
      "event": [
        "qq.group.at_message"
      ]
    },
    {
      "event": [
        "qq.group.message"
      ]
    }
  ],
  "buttons": [],
  "cron": [],
  "routes": [
    {
      "method": "GET",
      "path": "/voice-test/sample.wav",
      "auth": "public"
    },
    {
      "method": "GET",
      "path": "/meme/:id",
      "auth": "public"
    },
    {
      "method": "GET",
      "path": "/ui/*",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/overview",
      "auth": "admin"
    },
    {
      "method": "PUT",
      "path": "/api/groups/:groupId",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/groups/:groupId/memories",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/api/groups/:groupId/memories",
      "auth": "admin"
    },
    {
      "method": "DELETE",
      "path": "/api/groups/:groupId/memories/:id",
      "auth": "admin"
    },
    {
      "method": "DELETE",
      "path": "/api/groups/:groupId/memories",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/memes",
      "auth": "admin"
    },
    {
      "method": "PATCH",
      "path": "/api/memes/:id",
      "auth": "admin"
    },
    {
      "method": "DELETE",
      "path": "/api/memes/:id",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/api/sync-agent",
      "auth": "admin"
    }
  ],
  "hasMiddleware": false,
  "services": [
    "social"
  ],
  "durableObjects": [],
  "displayName": "拟人群聊",
  "description": "QQ 群聊多模态拟人娱乐互动插件：自然对话、图片理解、表情包素材库、智能接梗、人格设定与群级隔离记忆。",
  "configSchema": {
    "type": "object",
    "properties": {
      "model_alias": {
        "type": "string",
        "title": "对话模型别名",
        "description": "填写「LLM 接口」插件里的模型别名；留空使用全局默认模型。",
        "default": ""
      },
      "vision_model_alias": {
        "type": "string",
        "title": "视觉模型别名（Vision）",
        "description": "独立视觉模型别名（需在 LLM 接口开启 image 能力）；留空时回退到对话模型别名。",
        "default": ""
      },
      "default_mode": {
        "title": "默认群发言模式",
        "description": "auto：智能判断自然插话；at：仅被 @ 时回复；off：默认关闭（可按群开启）。",
        "oneOf": [
          {
            "const": "auto",
            "title": "智能插话（auto）"
          },
          {
            "const": "at",
            "title": "仅 @ 回复（at）"
          },
          {
            "const": "off",
            "title": "默认关闭（off）"
          }
        ],
        "default": "auto"
      },
      "default_persona": {
        "type": "string",
        "title": "默认人格 ID",
        "description": "内置人格：lively（活泼群友）、witty（幽默吐槽役）、warm（温柔陪伴）；也可填自定义人格 ID。",
        "default": "lively"
      },
      "yield_at_to_agent": {
        "type": "boolean",
        "title": "将 @机器人 让渡给 Agent（防重复回复）",
        "description": "同群启用 qflarebot-plugin-agent 时建议开启：本插件只负责非 @ 自然群聊，@机器人 交给 Agent 处理，避免重复调用模型和重复回复。",
        "default": true
      },
      "call_names": {
        "type": "string",
        "title": "全局呼唤词",
        "description": "逗号分隔（如：小Q,团子）。群消息包含这些词时会显著提高插话意愿。",
        "default": ""
      },
      "base_reply_probability": {
        "type": "number",
        "title": "基础插话概率",
        "description": "普通非 @ 群聊中的基础随机插话权重（0 到 1，建议 0.15 ~ 0.35）。",
        "minimum": 0,
        "maximum": 1,
        "default": 0.18
      },
      "trigger_threshold": {
        "type": "integer",
        "title": "智能触发阈值",
        "description": "启发式评分达到该值才调用 LLM 回复（0 ~ 100，越大越克制）。",
        "minimum": 0,
        "maximum": 100,
        "default": 55
      },
      "cooldown_seconds": {
        "type": "integer",
        "title": "回复冷却（秒）",
        "description": "同一群内两次拟人回复的最小间隔秒数。",
        "minimum": 0,
        "maximum": 3600,
        "default": 25
      },
      "max_replies_per_minute": {
        "type": "integer",
        "title": "每群每分钟回复上限",
        "description": "防止群聊刷屏与超预算消耗模型额度（0 表示不限制）。",
        "minimum": 0,
        "maximum": 30,
        "default": 3
      },
      "max_context_messages": {
        "type": "integer",
        "title": "短期上下文最大条数",
        "description": "每群滑窗保留的近期消息条数（建议 8 ~ 20）。",
        "minimum": 4,
        "maximum": 40,
        "default": 16
      },
      "context_ttl_minutes": {
        "type": "integer",
        "title": "短期上下文有效时长（分钟）",
        "description": "超过该时长的历史对话不再带入提示词。",
        "minimum": 5,
        "maximum": 1440,
        "default": 180
      },
      "enable_memory": {
        "type": "boolean",
        "title": "启用群聊长期记忆",
        "description": "按群隔离记录轻量娱乐梗与成员公开偏好，成员可随时通过 /social forgetme 删除。",
        "default": true
      },
      "memory_ttl_days": {
        "type": "integer",
        "title": "长期记忆保存天数",
        "description": "到期自动失效并清理，避免无限堆积。",
        "minimum": 1,
        "maximum": 90,
        "default": 30
      },
      "max_memories_per_group": {
        "type": "integer",
        "title": "单群最大记忆条数",
        "description": "超出时自动淘汰最旧记忆。",
        "minimum": 5,
        "maximum": 200,
        "default": 60
      },
      "llm_timeout_ms": {
        "type": "integer",
        "title": "对话模型调用超时（毫秒）",
        "description": "QQ 单事件总预算 30 秒，建议控制在 10000 ~ 15000 毫秒内。",
        "minimum": 3000,
        "maximum": 22000,
        "default": 14000
      },
      "max_output_tokens": {
        "type": "integer",
        "title": "单次回复最大 Token",
        "description": "控制群聊回复简短自然，建议 90 ~ 160。",
        "minimum": 32,
        "maximum": 1024,
        "default": 150
      },
      "temperature": {
        "type": "number",
        "title": "生成温度（Temperature）",
        "description": "越高越活泼有创意，建议 0.7 ~ 0.95。",
        "minimum": 0,
        "maximum": 2,
        "default": 0.85
      },
      "blocked_keywords": {
        "type": "string",
        "title": "内容过滤关键词",
        "description": "逗号分隔；入站命中则不触发，出站命中则拦截不发。",
        "default": ""
      },
      "enable_vision": {
        "type": "boolean",
        "title": "启用图片理解（Vision）",
        "description": "仅在触发回复或主动收藏表情包时按需调用视觉模型，不对所有群图无条件调用。",
        "default": true
      },
      "vision_rate_limit_per_minute": {
        "type": "integer",
        "title": "每群每分钟图片理解上限",
        "description": "超过频控自动降级为纯文本理解，防止群内刷图消耗额度（0 = 不限）。",
        "minimum": 0,
        "maximum": 30,
        "default": 4,
        "x-showIf": {
          "enable_vision": true
        }
      },
      "max_vision_images": {
        "type": "integer",
        "title": "单次最多解析图片数",
        "description": "限制单条消息（含引用）一次处理的图片数量，控制 Worker 内存与耗时。",
        "minimum": 1,
        "maximum": 3,
        "default": 2,
        "x-showIf": {
          "enable_vision": true
        }
      },
      "max_image_bytes": {
        "type": "integer",
        "title": "单张图片体积上限（字节）",
        "description": "默认 800000（约 800 KB），避免超大图触发 Worker 10ms CPU 或内存上限。",
        "minimum": 50000,
        "maximum": 2000000,
        "default": 800000,
        "x-showIf": {
          "enable_vision": true
        }
      },
      "image_cache_ttl_hours": {
        "type": "integer",
        "title": "图片理解结果缓存（小时）",
        "description": "相同图片按 SHA-256 复用已有视觉分析结果，避免重复调用模型。",
        "minimum": 1,
        "maximum": 720,
        "default": 72,
        "x-showIf": {
          "enable_vision": true
        }
      },
      "vision_timeout_ms": {
        "type": "integer",
        "title": "视觉模型调用超时（毫秒）",
        "description": "超时后自动降级为纯文本回复，不阻塞整条消息。",
        "minimum": 3000,
        "maximum": 18000,
        "default": 10000,
        "x-showIf": {
          "enable_vision": true
        }
      },
      "enable_meme_reply": {
        "type": "boolean",
        "title": "启用智能表情包回复",
        "description": "根据聊天语境从已收藏的群/全局表情包库匹配合适的表情包。",
        "default": true
      },
      "meme_send_probability": {
        "type": "number",
        "title": "表情包发送概率",
        "description": "命中合适表情包时的发送概率（0 ~ 1）。",
        "minimum": 0,
        "maximum": 1,
        "default": 0.35,
        "x-showIf": {
          "enable_meme_reply": true
        }
      },
      "meme_repeat_cooldown_seconds": {
        "type": "integer",
        "title": "重复表情包冷却（秒）",
        "description": "同一张表情包在同群内该时长内不会重复发送。",
        "minimum": 0,
        "maximum": 86400,
        "default": 180,
        "x-showIf": {
          "enable_meme_reply": true
        }
      },
      "max_consecutive_memes": {
        "type": "integer",
        "title": "最大连续表情包次数",
        "description": "防止连续刷图与机器人之间无限斗图循环。",
        "minimum": 1,
        "maximum": 5,
        "default": 2,
        "x-showIf": {
          "enable_meme_reply": true
        }
      },
      "meme_ttl_days": {
        "type": "integer",
        "title": "表情包资源保存天数",
        "description": "到期自动失效并在清理时同步删除 R2 文件与元数据。",
        "minimum": 1,
        "maximum": 365,
        "default": 90
      },
      "share_memes_across_groups": {
        "type": "boolean",
        "title": "跨群共享表情包库（不按群隔离）",
        "description": "默认开启：在任意群收藏的表情包所有群通用；关闭后恢复按群独立隔离（记忆与上下文仍保持严格群隔离）。",
        "default": true,
        "x-showIf": {
          "enable_meme_reply": true
        }
      },
      "use_global_meme_library": {
        "type": "boolean",
        "title": "群聊复用全局素材库",
        "description": "仅在关闭「跨群共享表情包库」时生效，控制是否同时匹配全局素材库。",
        "default": true,
        "x-showIf": {
          "enable_meme_reply": true
        }
      },
      "custom_personas": {
        "type": "array",
        "title": "自定义人格",
        "description": "新增自定义群聊人格，可通过 /social persona <ID> 绑定到指定群。",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "人格 ID（英文/数字）",
              "minLength": 1,
              "maxLength": 32
            },
            "name": {
              "type": "string",
              "title": "显示名称",
              "minLength": 1,
              "maxLength": 32
            },
            "description": {
              "type": "string",
              "title": "简介",
              "maxLength": 120
            },
            "systemPrompt": {
              "type": "string",
              "title": "系统提示词",
              "format": "textarea",
              "minLength": 1,
              "maxLength": 1500
            },
            "callNames": {
              "type": "string",
              "title": "专属呼唤词（逗号分隔）",
              "maxLength": 120
            }
          },
          "required": [
            "id",
            "name",
            "systemPrompt"
          ]
        },
        "default": []
      }
    }
  },
  "defaultConfig": {
    "model_alias": "",
    "vision_model_alias": "",
    "default_mode": "auto",
    "default_persona": "lively",
    "yield_at_to_agent": true,
    "call_names": "",
    "base_reply_probability": 0.18,
    "trigger_threshold": 55,
    "cooldown_seconds": 25,
    "max_replies_per_minute": 3,
    "max_context_messages": 16,
    "context_ttl_minutes": 180,
    "enable_memory": true,
    "memory_ttl_days": 30,
    "max_memories_per_group": 60,
    "llm_timeout_ms": 14000,
    "max_output_tokens": 150,
    "temperature": 0.85,
    "blocked_keywords": "",
    "custom_personas": [],
    "enable_vision": true,
    "vision_rate_limit_per_minute": 4,
    "max_vision_images": 2,
    "max_image_bytes": 800000,
    "image_cache_ttl_hours": 72,
    "vision_timeout_ms": 10000,
    "enable_meme_reply": true,
    "meme_send_probability": 0.35,
    "meme_repeat_cooldown_seconds": 180,
    "max_consecutive_memes": 2,
    "meme_ttl_days": 90,
    "share_memes_across_groups": true,
    "use_global_meme_library": true
  },
  "ui": {
    "path": "/ui/",
    "title": "拟人群聊"
  },
  "tools": [
    {
      "name": "get_recent_context",
      "service": "social",
      "method": "getRecentContext",
      "description": "读取当前 QQ 群最近的公开聊天滑窗上下文，用于了解群里刚刚聊了什么话题或接梗。仅限群聊使用；返回当前群的最近对话摘要文本与条数。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "description": "需要读取的最近消息条数，范围 1 到 20，默认 10。",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "permission": "member",
      "sideEffect": "none",
      "scenes": [
        "group"
      ],
      "version": 1,
      "timeoutMs": 8000
    },
    {
      "name": "search_memory",
      "service": "social",
      "method": "searchMemory",
      "description": "按关键词检索当前 QQ 群内已保存的娱乐互动记忆（群梗、成员公开偏好）。仅限当前群，严格群级隔离；query 留空时返回最新记忆列表。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "可选检索关键词（例如成员昵称或话题词）；留空返回最新记忆。",
            "maxLength": 60
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限，范围 1 到 20，默认 8。",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "permission": "member",
      "sideEffect": "none",
      "scenes": [
        "group"
      ],
      "version": 1,
      "timeoutMs": 8000
    }
  ]
}

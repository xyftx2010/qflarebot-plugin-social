{
  "name": "qflarebot-plugin-social",
  "version": "0.5.0",
  "description": "QFlareBot 多模态拟人 QQ 群聊娱乐互动插件：自然对话、图片理解、表情包素材库、智能接梗与群级隔离记忆",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "qflarebot-plugin",
    "qqbot",
    "social",
    "chat"
  ],
  "scripts": {
    "build": "qqbot-plugin build",
    "sync": "qqbot-plugin build && node -e \"require('node:fs').copyFileSync('dist/manifest.json','manifest.json')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@qqbot/plugin-cli": "file:../QFlareBot/packages/plugin-cli",
    "@qqbot/sdk": "file:../QFlareBot/packages/sdk",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
